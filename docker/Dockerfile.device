# syntax=docker/dockerfile:1
# IoT device: CPU only. Must not contain CUDA, so torch comes from the CPU wheel index.
FROM python:3.11-slim

# iproute2 provides tc for scripts/netem.sh; iputils-ping is for RTT checks.
RUN apt-get update \
    && apt-get install -y --no-install-recommends iproute2 iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# The build link can be slow or flaky: long timeouts, retries, resumable downloads (pip >= 25.1),
# and a BuildKit cache mount so wheels already downloaded survive a failed build.
ENV PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    PIP_RESUME_RETRIES=20 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN --mount=type=cache,target=/root/.cache/pip pip install --upgrade pip

RUN --mount=type=cache,target=/root/.cache/pip pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu

WORKDIR /app
# Editable install against an empty package, so the dependency layer is cached across source
# changes. torch is already satisfied above, so this does not pull the CUDA build.
COPY pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir -p src/edgeinf && touch src/edgeinf/__init__.py \
    && pip install -e .

COPY proto ./proto
COPY src ./src
COPY scripts ./scripts
# Same command as `make proto`; stubs are generated against the image's grpcio.
RUN mkdir -p src/edgeinf/rpc && touch src/edgeinf/rpc/__init__.py \
    && python -m grpc_tools.protoc -Iedgeinf/rpc=proto --python_out=src --grpc_python_out=src \
       proto/inference.proto

# Pin glibc malloc: keep freed tensors for reuse instead of returning them to the kernel and
# faulting them in again on every inference. Without this MobileNetV2 is about a third slower and
# its speed depends on what the process allocated earlier (experiments/calibration.md).
ENV GLIBC_TUNABLES=glibc.malloc.mmap_threshold=33554432:glibc.malloc.trim_threshold=268435456

# Idle until something is exec'd in: the device agent (python -m edgeinf.device.client, started
# by scripts/run_experiment.py), the smoke test or a profiler.
CMD ["sleep", "infinity"]
